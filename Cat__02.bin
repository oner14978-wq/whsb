    }
    public static FloatBuffer glfwGetJoystickAxes(int jid) {
        if (jid != 0) return null;
        ensureGamepadBuffers();
        return gamepadAxisData;
    }
    public static ByteBuffer glfwGetJoystickButtons(int jid) {
        if (jid != 0) return null;
        ensureGamepadBuffers();
        return gamepadButtonData;
    }
