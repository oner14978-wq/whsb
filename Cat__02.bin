package com.movtery.layer_controller.observable

import androidx.compose.runtime.getValue
import androidx.compose.runtime.mutableStateOf
import androidx.compose.runtime.setValue
import androidx.compose.ui.Modifier
import androidx.compose.ui.geometry.Offset
import androidx.compose.ui.input.pointer.PointerId
import androidx.compose.ui.unit.IntSize
import com.movtery.layer_controller.data.ButtonPosition
import com.movtery.layer_controller.data.ButtonSize
import com.movtery.layer_controller.data.VisibilityType
import com.movtery.layer_controller.event.EventHandler

/**
 * ÂèØËßÇÂØüÁöÑÊéß‰ª∂ÂåÖË£ÖÂü∫Á±ª
 */
abstract class ObservableWidget {
    /**
     * ÁºñËæëÊ®°Âºè‰∏≠ÔºåÊòØÂê¶Ê≠£Âú®ÁºñËæë‰ΩçÁΩÆ
     */
    var isEditingPos by mutableStateOf(false)

    /**
     * ÁºñËæëÊ®°Âºè‰∏≠ÔºåËÆ∞ÂΩïÂÆûÊó∂ÂÅèÁßªÈáè
     */
    var movingOffset by mutableStateOf(Offset.Zero)

    /**
     * Êéß‰ª∂ÁöÑÂÜÖÈÉ®Ê∏≤ÊüìÂ§ßÂ∞è
     */
    internal var internalRenderSize by mutableStateOf(IntSize.Zero)

    /**
     * ÁªÑ‰ª∂ÁöÑÂÜÖÈÉ®Ê∏≤Êüì‰ΩçÁΩÆÂ±ûÊÄß
     */
    internal abstract val internalRenderPosition: ButtonPosition

    /**
     * Â≠òÂÖ•ÂÜÖÈÉ®Ê∏≤Êüì‰ΩçÁΩÆÂ±ûÊÄß
     */
    internal abstract fun putRenderPosition(position: ButtonPosition)

    /**
     * ÁªÑ‰ª∂ÁöÑÊ†∑Âºè ID
     */
    internal abstract val styleId: String?

    /**
     * ÁªÑ‰ª∂ÁöÑÂ§ßÂ∞èÂ±ûÊÄß
     */
    internal abstract val widgetSize: ButtonSize

    /**
     * Â≠òÂÖ•ÁªÑ‰ª∂ÁöÑÂ§ßÂ∞èÂ±ûÊÄß
     */
    internal abstract fun putWidgetSize(size: ButtonSize)

    /**
     * Êéß‰ª∂ÁöÑ‰∫§‰∫íË°å‰∏∫Ê®°Âûã
     */
    abstract val behavior: InteractionBehavior

    /**
     * Á°ÆËÆ§ËØ•ÁªÑ‰ª∂ÊòØÂê¶ÂèØ‰ª•ÂìçÂ∫îËß¶Êë∏‰∫ã‰ª∂
     */
    open fun canTouch(): Boolean = true

    /**
     * ‰∏∫ËØ•Êéß‰ª∂Êèê‰æõËß¶Êë∏‰∫ã‰ª∂Â§ÑÁêÜÁöÑ Modifier
     * ÊØè‰∏™Êéß‰ª∂ÈÄöËøáËá™Â∑±ÁöÑ pointerInput Áã¨Á´ãÂ§ÑÁêÜËß¶Êë∏‰∫ã‰ª∂
     * @param onOccupiedPointer ÂΩìÂç†Áî®‰∏Ä‰∏™ÊåáÈíàÊó∂ÂõûË∞ÉÔºåÁî®‰∫éÈöîÁ¶ªÊåáÈíà
     * @param onReleasePointer ÂΩìÈáäÊîæ‰∏Ä‰∏™ÊåáÈíàÊó∂ÂõûË∞É
     */
    open fun Modifier.touchModifier(
        pointerEventBus: PointerEventBus,
        eventHandler: EventHandler,
        allLayers: List<ObservableControlLayer>,
        screenSize: IntSize,
        onOccupiedPointer: (PointerId) -> Unit = {},
        onReleasePointer: (PointerId) -> Unit = {}
    ): Modifier = this

    /**
     * Compose Ê†ëÂºÄÂßãÂ∏ÉÂ±ÄÊó∂
     */
    abstract fun onCompositionStart(eventHandler: EventHandler?)

    /**
     * Compose Ê†ëÁªìÊùüÂ∏ÉÂ±ÄÊó∂
     */
    abstract fun onCompositionDispose(eventHandler: EventHandler?)

    /**
     * Ëé∑ÂèñËØ•ÁªÑ‰ª∂ÂèØËßÅÁ±ªÂûã
     */
    abstract fun onCheckVisibilityType(): VisibilityType

    /**
     * Âà§Êñ≠ËØ•ÁªÑ‰ª∂ÊòØÂê¶ÊîØÊåÅÊ∑±Â∫¶Ëß¶Êë∏Ê£ÄÊµãÂíåÂèñÊúÄÊ∑±Êìç‰Ωú
     */
    abstract fun supportsDeepTouchDetection(): Boolean

    /**
     * Ê£ÄÊü•ÊòØÂê¶Ë¶ÅÂ§ÑÁêÜËøô‰∏™Ëß¶Êë∏‰∫ã‰ª∂
     * @return ÊòØÂê¶ÂèØ‰ª•Â§ÑÁêÜ
     */
    abstract fun canProcess(): Boolean

    /**
     * ÂìçÂ∫îËß¶Êë∏‰∫ã‰ª∂
     * @param allLayers ÂΩìÂâçÊâÄÊúâÂèØËßÇÂØüÊéßÂà∂Â±Ç
     * @param activeWidgets ÂΩìÂâçÊåáÈíàÊ¥ªÂä®‰∏≠ÁöÑÁªÑ‰ª∂
     * @param addThis Ê†áËÆ∞ÁªÑ‰ª∂Âú®ËØ•ÊåáÈíàÊ¥ªÂä®
     * @param consumeEvent ÊòØÂê¶Ë¶ÅÊ±ÇÊ†áËÆ∞Ê∂àË¥π‰∫ã‰ª∂
     */
    abstract fun onTouchEvent(
        eventHandler: EventHandler,
        allLayers: List<ObservableControlLayer>,
        activeWidgets: List<ObservableWidget>,
        addThis: () -> Unit,
        consumeEvent: (Boolean) -> Unit
    )

    /**
     * Áî®‰∫éÂà§Êñ≠ÁªÑ‰ª∂ÊòØÂê¶ÊîØÊåÅ ÁßªÂá∫ËæπÁïåÂç≥ËßÜ‰∏∫ÊùæÂºÄ ÁöÑ‰∫§‰∫íË°å‰∏∫
     */
    abstract fun isReleaseOnOutOfBounds(): Boolean

    /**
     * ÊâãÊåáÂõûÂà∞ÁªÑ‰ª∂ÂÜÖ
     * @param allLayers ÂΩìÂâçÊâÄÊúâÂèØËßÇÂØüÊéßÂà∂Â±Ç
     */
    abstract fun onPointerBackInBounds(
        eventHandler: EventHandler,
        allLayers: List<ObservableControlLayer>
    )

    /**
     * ÂìçÂ∫îÊùæÂºÄËß¶Êë∏‰∫ã‰ª∂
     * @param allLayers ÂΩìÂâçÊâÄÊúâÂèØËßÇÂØüÊéßÂà∂Â±Ç
     */
    abstract fun onReleaseEvent(
        eventHandler: EventHandler,
        allLayers: List<ObservableControlLayer>
    )
}PK
