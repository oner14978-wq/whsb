 */
@Composable
fun TransparentChecker(
    modifier: Modifier = Modifier,
    gridSize: Float = 20f,
) {
    Canvas(modifier) {
        transparentCheckerBackground(
            width = size.width,
            height = size.height,
            gridSize = gridSize
        )
    }
}PK
