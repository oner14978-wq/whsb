package com.movtery.layer_controller.event

import com.movtery.layer_controller.observable.Modifiable
import kotlinx.serialization.SerialName
import kotlinx.serialization.Serializable

/**
 * ÊåâÈîÆÁÇπÂáª‰∫ã‰ª∂
 * @param type ÁªëÂÆöÁöÑÁÇπÂáª‰∫ã‰ª∂Á±ªÂûã
 * @param key ‰∫ã‰ª∂ÂîØ‰∏ÄÊ†áËØÜ/‰∫ã‰ª∂ÂÄº
 */
@Serializable
data class ClickEvent(
    @SerialName("type")
    val type: Type,
    @SerialName("key")
    val key: String
): Modifiable<ClickEvent> {
    @Serializable
    enum class Type {
        /**
         * ÁÇπÂáªËß¶ÂèëÊåâÈîÆ
         */
        @SerialName("key")
        Key,

        /**
         * ÁÇπÂáªËß¶ÂèëÂêØÂä®Âô®‰∫ã‰ª∂
         */
        @SerialName("launcher_event")
        LauncherEvent,

        /**
         * ÁÇπÂáªÂºÄÂÖ≥Êéß‰ª∂Â±Ç
         */
        @SerialName("switch_layer")
        SwitchLayer,

        /**
         * ÁÇπÂáªÂº∫Âà∂ÊòæÁ§∫Êéß‰ª∂Â±Ç
         */
        @SerialName("show_layer")
        ShowLayer,

        /**
         * ÁÇπÂáªÂº∫Âà∂ÈöêËóèÊéß‰ª∂Â±Ç
         */
        @SerialName("hide_layer")
        HideLayer,

        /**
         * ÁÇπÂáªÂèëÈÄÅËÅäÂ§©Ê∂àÊÅØ
         */
        @SerialName("send_text")
        SendText;

        /**
         * ËØ•ÁÇπÂáª‰∫ã‰ª∂Á±ªÂûãÊòØÂê¶ÂÖ≥‰∫éÊéß‰ª∂Â±Ç
         */
        fun isAboutLayers(): Boolean =
            this == SwitchLayer ||
                    this == ShowLayer ||
                    this == HideLayer
    }

    /**
     * ËØ•ÁÇπÂáª‰∫ã‰ª∂ÊòØÂê¶ÂÖ≥‰∫éÊéß‰ª∂Â±Ç
     */
    fun isAboutLayers(): Boolean = type.isAboutLayers()

    override fun isModified(other: ClickEvent): Boolean {
        return this.type != other.type ||
                this.key != other.key
    }
}PK
