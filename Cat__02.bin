/** Âç°Áâá‰∏éÁî®Êà∑ÁöÑ‰∫§‰∫íÁä∂ÊÄÅ */
enum class CardInteraction { Idle, Adjusting, Dragging, Resizing }

/**
 * Êèê‰æõÁªôÂç°ÁâáÂÜÖÂÆπÁöÑËá™Ë∫´Áä∂ÊÄÅÔºå
 * Âç°Áâá‰æùÊçÆÂ∞∫ÂØ∏ÂΩ¢ÊÄÅ‰∏é‰∫§‰∫íÁä∂ÊÄÅÂàáÊç¢‰∏çÂêåÁöÑÊòæÁ§∫ÂΩ¢ÊÄÅ„ÄÇ
 */
class CardState(
    val spanWidth: Int,
    val spanHeight: Int,
    val columns: Int,
    val interaction: CardInteraction
) {
    /** ‰æùÊçÆË∑®Â∫¶Êé®ÂØºÁöÑÂΩ¢ÊÄÅÂàÜÁ±ª */
    val sizeClass: CardSize = deriveSizeClass(spanWidth, spanHeight, columns)
}

/** Âç°ÁâáÁü©ÂΩ¢Âú®ÂçïÂÖÉÊ†ºÂÜÖÂêëÂõõËæπÁöÑÂÜÖÁº©Èáè */
val CardSpacing: Dp = 6.dp
