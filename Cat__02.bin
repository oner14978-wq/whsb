    public static boolean glfwGetGamepadState(int jid, GLFWGamepadState state) {
        if (jid != 0 || state == null) return false;
        ensureGamepadBuffers();
        memCopy(gamepadDataPointer, state.address(), state.sizeof());
        return true;
    }

