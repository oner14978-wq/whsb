package com.movtery.cardgrid.model

import kotlin.math.roundToInt

/** ÁΩëÊ†ºÁöÑÊúÄÂ∞èÂàóÊï∞ */
const val MIN_GRID_COLUMNS = 4

/** ÂçïÂÖÉÊ†ºËæπÈïøÁöÑËÆæËÆ°ÁõÆÊ†áÂÄºÔºàdpÔºâ */
const val DEFAULT_TARGET_CELL_SIZE = 20f

/**
 * ÁΩëÊ†ºÂá†‰Ωï‰ø°ÊÅØ„ÄÇ
 * [columns] ÂàóÊï∞ÊÅí‰∏∫ÂÅ∂Êï∞Ôºå‰øùËØÅÂç°ÁâáÂèØ‰∏•Ê†ºÂØπÈΩêÂçäÂÆΩÁ≠âÂØπÁß∞ÂàÜÂâ≤Ôºõ
 * [cellSize] ‰∏∫Âçï‰∏™Ê≠£ÊñπÂΩ¢ÂçïÂÖÉÊ†ºÁöÑËæπÈïøÔºàdpÔºâÔºå
 * ÁΩëÊ†ºÈ¶ñÂ∞æ‰∏§Á´Ø‰∏éÂÆπÂô®ËæπÁºò‰∏•Ê†ºÂØπÈΩê„ÄÇ
 */
data class GridGeometry(
    val columns: Int,
    val cellSize: Float
)

/**
 * ‰æùÊçÆÂÆπÂô®ÂÆΩÂ∫¶ËÆ°ÁÆóÁΩëÊ†ºÔºö
 * ‰ª• [targetCellSize] ‰∏∫ÁõÆÊ†áÁªÜÂàÜÂá∫ÂÅ∂Êï∞ÂàóÔºåÂÆΩÂ∫¶‰ΩôÊï∞Âπ≥ÊëäËøõÊØè‰∏™ÂçïÂÖÉÊ†ºÔºå
 * ‰ΩøÂçïÂÖÉÊ†ºËæπÈïø‰øùÊåÅÂú®ÁõÆÊ†áÂÄºÈôÑËøë„ÄÅÁΩëÊ†ºËæπÁºò‰∏éÂÆπÂô®ËæπÁºòÂØπÈΩê„ÄÇ
 */
fun computeGridGeometry(
    widthDp: Float,
    targetCellSize: Float = DEFAULT_TARGET_CELL_SIZE
): GridGeometry {
    if (widthDp <= 0f) return GridGeometry(MIN_GRID_COLUMNS, targetCellSize)
    val evenColumns = (widthDp / targetCellSize / 2f)
        .roundToInt()
        .coerceAtLeast(MIN_GRID_COLUMNS / 2) * 2
    return GridGeometry(columns = evenColumns, cellSize = widthDp / evenColumns)
}
