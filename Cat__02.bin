package com.movtery.layer_controller.observable

interface Packable<E> {
    /**
     * @return ÊâìÂåÖÂêéÁöÑÂØπË±°ÔºåÁ±ªÂûã‰∏∫ [E]
     */
    fun pack(): E

    /**
     * @return ÂØπË±°Ëá™‰∏äÊ¨°Ê£ÄÊü•‰ª•Êù•ÊòØÂê¶Ë¢´‰øÆÊîπËøáÔºåÂê¶Âàô‰∏∫`false`
     */
    fun isModified(): Boolean
}PK
